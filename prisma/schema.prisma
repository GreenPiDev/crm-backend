generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("trial")
  createdAt DateTime @default(now())
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  fullName     String
  role         Role      @default(SALES)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  @@unique([tenantId, email])
}

enum Role {
  OWNER
  ADMIN
  SALES
  VIEWER
}
